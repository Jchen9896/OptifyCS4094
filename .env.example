# Local development environment. Copy to `.env` and keep `.env` uncommitted.

POSTGRES_USER=optify
POSTGRES_PASSWORD=optify
POSTGRES_DB=optify
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=8080

# Used by host-side scripts (check_db.py) and optional local uvicorn.
# The Compose `api` service overrides this to use hostname `db`.
DATABASE_URL=postgresql+psycopg2://optify:optify@localhost:5432/optify

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWT_KEY=

# Fernet key for encrypting per-user brokerage BYOK secrets at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=

# Schwab OAuth: API public HTTPS base (callback host) and frontend return URL.
# Register PUBLIC_API_BASE_URL/api/brokerage-credentials/schwab/callback in the Schwab app.
PUBLIC_API_BASE_URL=https://127.0.0.1:8000
FRONTEND_APP_URL=http://127.0.0.1:5173

# Gemini assistant (Decision 013). Required for /api/chat and knowledge ingest.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
CHAT_RAG_TOP_K=6


# Market data provider and stored-history provenance (Decision 006).
MARKET_DATA_INTERVAL=1d
MARKET_DATA_AUTO_ADJUST=true
MARKET_DATA_SEARCH_LIMIT=10
MARKET_DATA_SOURCE=yfinance
MARKET_DATA_CALENDAR=XNYS
MARKET_DATA_MAX_SPAN_DAYS=3650
