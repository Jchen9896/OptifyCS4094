# Local development environment. Copy to `.env` and keep `.env` uncommitted.

POSTGRES_USER=optify
POSTGRES_PASSWORD=optify
POSTGRES_DB=optify
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=8080

# Used by host-side scripts (check_db.py) and optional local uvicorn.
# The Compose `api` service overrides this to use hostname `db`.
DATABASE_URL=postgresql+psycopg2://optify:optify@localhost:5432/optify

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data provider and stored-history provenance (Decision 006).
MARKET_DATA_INTERVAL=1d
MARKET_DATA_AUTO_ADJUST=true
MARKET_DATA_SEARCH_LIMIT=10
MARKET_DATA_SOURCE=yfinance
MARKET_DATA_CALENDAR=XNYS
MARKET_DATA_MAX_SPAN_DAYS=3650
